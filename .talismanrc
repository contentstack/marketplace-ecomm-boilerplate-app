fileignoreconfig:
- filename: .github/workflows/secrets-scan.yml
  ignore_detectors:
    - filecontent
- filename: package-lock.json
  ignore_detectors:
    - filecontent
    - base64content
- filename: api/package-lock.json
  ignore_detectors:
    - filecontent
    - base64content
- filename: ui/package-lock.json
  ignore_detectors:
    - filecontent
    - base64content
version: "1.0"