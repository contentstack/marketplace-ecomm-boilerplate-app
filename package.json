{
  "name": "marketplace-ecommerce-boilerplate-app",
  "version": "1.0.0",
  "description": "Contentstack Ecommerce Boilerplate Marketplace App",
  "scripts": {
    "test": "npm --prefix api test && npm --prefix ui test",
    "test:coverage": "npm --prefix api run test:coverage && npm --prefix ui run test:coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contentstack/marketplace-ecomm-boilerplate-app.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/contentstack/marketplace-ecomm-boilerplate-app/issues"
  },
  "homepage": "https://github.com/contentstack/marketplace-ecomm-boilerplate-app#readme",
  "devDependencies": {
    "husky": "^4.3.8",
    "prettier": "^2.4.1",
    "rimraf": "^3.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "cd ui && rimraf build && npm run precommit && cd ../api && rimraf build && npm run precommit"
    }
  }
}
